# dtn-net.service: IBSS bring-up for wlan1 (file 01 step 5).
#
# Bound to the INTERFACE, not to boot. The original version was a plain
# boot-time oneshot, which failed in a way that was very hard to read: if
# the USB adapter was not present at boot, the script exited, systemd
# retried a few times, hit the start limit, and gave up permanently.
# Plugging the adapter in afterwards then re-ran nothing. The node had no
# mesh, no peers, and no sync log lines at all, and the only cure anybody
# found was rebooting the whole board.
#
# That matters more than it sounds because the fleet has fewer AR9271
# adapters than nodes, so adapters get moved between nodes routinely.
#
# WantedBy the .device unit means this starts the moment wlan1 appears,
# at boot or on hotplug. BindsTo means it stops cleanly when the adapter
# is unplugged, so the next insertion starts it fresh rather than finding
# a unit that thinks it is still active.
[Unit]
Description=Rescue mesh DTN radio (wlan1 IBSS)
BindsTo=sys-subsystem-net-devices-wlan1.device
After=sys-subsystem-net-devices-wlan1.device

[Service]
Type=oneshot
RemainAfterExit=yes
# The adapter needs a moment after enumeration before iw will accept a
# mode change. Shorter than the old boot-time wait because by the time
# this unit runs the device already exists.
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/sbin/dtn-net-up.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=sys-subsystem-net-devices-wlan1.device
